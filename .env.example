NODE_ENV=development

LLM_PROVIDER=local
LLM_BASE_URL=http://127.0.0.1:8080/v1
LLM_API_KEY=
LLM_MODEL=your-model-alias

MONGODB_MODE=local
MONGODB_LOCAL_URI=mongodb://127.0.0.1:27017/estiforge
MONGODB_ATLAS_URI=

DEBUG_LOGS=true
LOG_LEVEL=debug

VOICE_STT_ENABLED=true
VOICE_STT_ENGINE=whisper.cpp
VOICE_STT_MODEL_PATH=./models/whisper-tiny
VOICE_STT_URL=http://127.0.0.1:8178

VOICE_TTS_ENABLED=false

SESSION_SECRET=replace-with-a-random-session-secret-32b
